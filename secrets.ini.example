; Copy to secrets.ini and fill in. secrets.ini is git-ignored.
; Any define from src/support.h wrapped in #ifndef can be overridden here.
[secrets]
build_flags =
    '-DWIFI_SSID="your-ssid"'
    '-DWIFI_PASSWORD="your-password"'
    '-DMQTT_SERVER="192.168.1.10"'
    '-DMQTT_USER=""'
    '-DMQTT_PASSWORD=""'
    '-DOTA_PASSWORD=""'
