; Copy to secrets.ini and fill in. secrets.ini is git-ignored.
; WiFi credentials are NOT set here: they are entered on the setup page of the
; "MHI-AC-Ctrl-Setup" access point the device opens when it has no WiFi.
; The MQTT values below are only defaults until saved on that setup page.
[secrets]
build_flags =
    '-DSETUP_AP_PASSWORD="choose-a-password"'   ; min. 8 characters
    '-DMQTT_SERVER="192.168.1.10"'
    '-DMQTT_USER=""'
    '-DMQTT_PASSWORD=""'
    '-DOTA_PASSWORD=""'
