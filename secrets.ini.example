; Copy to secrets.ini and fill in. secrets.ini is git-ignored.
; WiFi credentials are NOT set here: they are entered on the setup page of the
; "<hostname>-Setup" access point the device opens when it has no WiFi.
; MQTT broker, hostname and device password set here are only defaults until
; they are changed on the settings page.
[secrets]
build_flags =
    '-DDEVICE_PASSWORD="choose-a-password"'   ; setup AP, settings login (user admin), OTA; min. 8 characters
                                              ; leave out for a random password (printed in the serial log)
    '-DMQTT_SERVER="192.168.1.10"'
    '-DMQTT_USER=""'
    '-DMQTT_PASSWORD=""'
;   '-DHOSTNAME="Living-Room-AC"'
;   -DHA_DISCOVERY=0                          ; disable Home Assistant MQTT discovery

; OTA uploads (pio run -e d1_mini_ota -t upload) need the device password:
[env:d1_mini_ota]
upload_flags = --auth=choose-a-password
